#!/bin/sh
set -eu

if git diff --cached --name-only --diff-filter=ACMR | grep -Eq '(^|/)(node_modules|dist|target|build|coverage|\.idea|\.vscode)(/|$)|(^|/)(\.env|\.env\.)|\.(class|log)$'; then
  echo "ERROR: Build artifacts, dependencies, IDE config, and secrets are not allowed in commits."
  exit 1
fi

echo "Pre-commit checks passed."
